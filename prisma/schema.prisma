generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Medicine {
  id                String              @id @default(uuid())
  name              String
  genericName       String?
  category          String
  form              String
  unit              String
  reorderLevel      Int                 @default(50)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  barcode           String?             @unique
  prescriptionItems PrescriptionItem[]
  purchaseItems     PurchaseOrderItem[]
  stockBatches      StockBatch[]
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model StockBatch {
  id              String   @id @default(uuid())
  medicineId      String
  batchNumber     String
  expiryDate      DateTime
  initialQuantity Int
  currentQuantity Int
  unitPrice       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  medicine        Medicine @relation(fields: [medicineId], references: [id])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String
  status      String              @default("PENDING")
  totalAmount Float               @default(0)
  orderDate   DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  medicineId      String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime      @default(now())
  medicine        Medicine      @relation(fields: [medicineId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model Invoice {
  id          String            @id @default(uuid())
  visitId     String?
  patientId   String?
  status      String            @default("DRAFT")
  subtotal    Float             @default(0)
  totalAmount Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lineItems   InvoiceLineItem[]
  payments    Payment[]
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  department  String
  referenceId String?
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  amount         Float
  method         String
  status         String   @default("COMPLETED")
  transactionRef String?
  createdAt      DateTime @default(now())
  appointmentId  String?  @unique
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  Appointment    Appointment? @relation(fields: [appointmentId], references: [id])
}

model Refund {
  id        String   @id @default(uuid())
  paymentId String
  amount    Float
  reason    String
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
}

model LabTest {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  price       Float
  category    String?
  sampleType  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       LabRequestItem[]
}

model LabRequest {
  id          String   @id @default(uuid())
  patientId   String
  doctorId    String?
  status      String         @default("PENDING")
  requestedAt DateTime       @default(now())
  priority    String         @default("ROUTINE")
  reportUrl   String?
  visitId     String?
  
  Patient     Patient  @relation(fields: [patientId], references: [id])
  Visit       Appointment? @relation(fields: [visitId], references: [id])
  items       LabRequestItem[]
  results     LabResult[]
}

model LabRequestItem {
  id            String     @id @default(uuid())
  labRequestId  String
  labTestId     String
  price         Float
  
  LabRequest    LabRequest @relation(fields: [labRequestId], references: [id])
  LabTest       LabTest    @relation(fields: [labTestId], references: [id])
}

model LabResult {
  id           String     @id @default(uuid())
  requestId    String
  biomarker    String
  value        String
  isOutOfRange Boolean    @default(false)
  notes        String?
  recordedAt   DateTime   @default(now())
  request      LabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Float
  description String
  status      String   @default("COMPLETED")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prescription {
  id            String             @id @default(uuid())
  patientId     String
  patientName   String?
  visitId       String
  doctorId      String
  doctorName    String?
  status        String             @default("PENDING")
  diagnosis     String?
  clinicalNotes String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         PrescriptionItem[]
  Patient       Patient            @relation(fields: [patientId], references: [id])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineId     String?
  drugName       String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  dispenseQty    Int          @default(0)
  createdAt      DateTime     @default(now())
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Patient {
  id               String   @id @default(uuid())
  patientId        String?  @unique @default(cuid()) // Unique MRN, using cuid as temporary default before migration
  fullName         String
  phone            String   @unique
  dateOfBirth      DateTime?
  ageFallback      Int?     // For quick registration without DOB
  gender           String?
  nic              String?
  address          String?
  emergencyContact String?
  bloodGroup       String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  LabRequests      LabRequest[]
  Prescription     Prescription[]
  Appointment      Appointment[]
}

model Permission {
  id             String           @id @default(uuid())
  action         String
  resource       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  RolePermission RolePermission[]

  @@unique([action, resource])
}

model Role {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  RolePermission RolePermission[]
  User           User[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)


  @@unique([roleId, permissionId])
}

model Appointment {
  id                String   @id @default(uuid())
  tokenNumber       String
  patientId         String
  doctorId          String?
  sessionId         String?
  department        String   @default("CONSULTATION")
  appointmentDate   DateTime @default(now())
  status            String   @default("BOOKED") // BOOKED, CHECKED_IN, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  bookingType       String   @default("WALK_IN") // WALK_IN, PHONE
  bookingReference  String?  @unique
  bookedAt          DateTime @default(now())
  checkedInAt       DateTime?
  calledAt          DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Payment           Payment?
  User              User?    @relation(fields: [doctorId], references: [id])
  Patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Session           DoctorScheduleSession? @relation(fields: [sessionId], references: [id])
  LabRequests       LabRequest[]

  @@unique([doctorId, appointmentDate, tokenNumber])
}

model User {
  id             String   @id @default(uuid())
  fullName       String
  email          String   @unique
  password       String
  roleId         String
  specialty      String?
  roomNumber     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Appointment    Appointment[]
  DoctorSchedule DoctorSchedule[]
  DoctorAttendance DoctorAttendance[]
  Role           Role     @relation(fields: [roleId], references: [id])
}

model DoctorSchedule {
  id           String                  @id @default(uuid())
  doctorId     String
  doctor       User                    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  validFrom    DateTime                @default(now())
  validUntil   DateTime?
  sessions     DoctorScheduleSession[]
  exceptions   DoctorScheduleException[]
  leaves       DoctorLeave[]
}

model DoctorScheduleSession {
  id               String         @id @default(uuid())
  scheduleId       String
  schedule         DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek        Int            // 0=Sun, 1=Mon, etc.
  sessionName      String         // e.g., "Morning", "Evening"
  startTime        String         // "08:00"
  endTime          String         // "12:00"
  tokenCapacity    Int            @default(40)
  walkInPercentage Int            @default(100) // % allowed for walk-ins vs appointments
  isActive         Boolean        @default(true)
  Appointment      Appointment[]
}

model DoctorScheduleException {
  id               String         @id @default(uuid())
  scheduleId       String
  schedule         DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  exceptionDate    DateTime       // Specific date of change
  isUnavailable    Boolean        @default(false)
  newStartTime     String?
  newEndTime       String?
  newTokenCapacity Int?
}

model DoctorLeave {
  id           String         @id @default(uuid())
  scheduleId   String
  schedule     DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String         @default("APPROVED")
}

model SmsTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationJob {
  id          String   @id @default(uuid())
  patientId   String
  phoneNumber String
  message     String
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  errorReason String?
  scheduledFor DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

model DoctorAttendance {
  id          String   @id @default(uuid())
  doctorId    String
  date        DateTime @default(now())
  status      String   @default("SCHEDULED") // SCHEDULED, ARRIVED, IN_CONSULTATION, ON_BREAK, LEFT
  roomNumber  String?
  arrivedAt   DateTime?
  leftAt      DateTime?
  doctor      User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

